{#- Social links. Only networks with a URL in site.json → social are shown. -#}
{%- set glyphs = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-6.5M12 13.5c0-1.7 1-3 2.5-3s2.5 1 2.5 3V17"/>',
  x: '<path d="M4 4h4.5L20 20h-4.5z"/><path d="M20 4l-6.6 7.3M10.6 12.7L4 20"/>',
  facebook: '<path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z"/>'
} -%}
<ul class="social-list" aria-label="Social media">
  {%- for key in ["instagram", "linkedin", "x", "facebook"] %}
  {%- if site.social[key] %}
  <li>
    <a href="{{ site.social[key] }}" rel="noopener" aria-label="{{ site.name }} on {{ socialLabels[key] }}">
      <svg class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ glyphs[key] | safe }}</svg>
    </a>
  </li>
  {%- endif %}
  {%- endfor %}
</ul>
